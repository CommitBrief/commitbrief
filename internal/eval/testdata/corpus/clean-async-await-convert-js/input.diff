+async function placeOrder(cart, user) {
+  if (cart.items.length === 0) return null;
+  try {
+    const reservation = await inventory.reserve(cart.items);
+    const charge = await payments.charge(user.id, cart.totalCents);
+    return await orders.create({
+      userId: user.id,
+      items: cart.items,
+      chargeId: charge.id,
+      reservationId: reservation.id,
+    });
+  } catch (err) {
+    throw new CheckoutError("placeOrder failed", { cause: err });
+  }
