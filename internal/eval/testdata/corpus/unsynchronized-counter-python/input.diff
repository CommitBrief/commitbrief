@@ -0,0 +1,16 @@
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+processed = 0
+
+
+def handle(job):
+    global processed
+    job.run()
+    processed += 1
+
+
+def run_all(jobs):
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        list(pool.map(handle, jobs))
+    return processed
