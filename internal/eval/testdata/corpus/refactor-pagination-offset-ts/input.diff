+export async function searchListings(query: ListingQuery): Promise<ListingPage> {
+  const all = await listings.all();
+  const filtered = applyFilters(all, query);
+  const sorted = sortListings(filtered, query.sort ?? "newest");
+  return paginate(sorted, query.page, query.pageSize);
+}
+
+function applyFilters(all: Listing[], query: ListingQuery): Listing[] {
+  let out = all;
+  if (query.city) {
+    const city = query.city.toLowerCase();
+    out = out.filter((l) => l.city.toLowerCase() === city);
+  }
+  if (query.minPrice !== undefined) {
+    const min = query.minPrice;
+    out = out.filter((l) => l.priceCents >= min);
+  }
+  if (query.maxPrice !== undefined) {
+    const max = query.maxPrice;
+    out = out.filter((l) => l.priceCents <= max);
+  }
+  if (query.tags && query.tags.length > 0) {
+    const tags = query.tags;
+    out = out.filter((l) => tags.every((t) => l.tags.includes(t)));
+  }
+  return out;
+}
+
+function sortListings(input: Listing[], key: ListingQuery["sort"]): Listing[] {
+  const sorted = [...input];
+  switch (key) {
+    case "price_asc":
+      sorted.sort((a, b) => a.priceCents - b.priceCents);
+      break;
+    case "price_desc":
+      sorted.sort((a, b) => b.priceCents - a.priceCents);
+      break;
+    default:
+      sorted.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());
+  }
+  return sorted;
+}
+
+function paginate(
+  sorted: Listing[],
+  requestedPage: number | undefined,
+  requestedSize: number | undefined,
+): ListingPage {
+  const pageSize = Math.min(requestedSize ?? DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE);
+  const page = Math.max(requestedPage ?? 1, 1);
+  const start = page * pageSize;
+  const items = sorted.slice(start, start + pageSize);
+
+  return {
+    items,
+    page,
+    pageSize,
+    total: sorted.length,
+    hasMore: start + pageSize < sorted.length,
+  };
+}
+
+export function buildFacets(items: Listing[]): Facets {
+  return {
+    cities: countBy(items, (l) => [l.city]),
+    tags: countBy(items, (l) => l.tags),
+    priceBuckets: countBy(items, (l) => [priceBucket(l.priceCents)]),
+  };
+}
+
+function countBy(items: Listing[], keys: (l: Listing) => string[]): Record<string, number> {
+  const counts = new Map<string, number>();
+  for (const item of items) {
+    for (const key of keys(item)) {
+      counts.set(key, (counts.get(key) ?? 0) + 1);
+    }
+  }
+  return Object.fromEntries(counts);
+}
+
+function priceBucket(cents: number): string {
+  if (cents < 50_000) return "under-500";
+  if (cents < 100_000) return "500-1000";
+  if (cents < 250_000) return "1000-2500";
+  return "2500-plus";
+}
 
 export async function getListing(id: string): Promise<Listing | undefined> {
   return listings.byId(id);
 }
