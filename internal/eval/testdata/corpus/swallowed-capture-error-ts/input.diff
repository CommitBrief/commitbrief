 export async function completeOrder(order: Order): Promise<void> {
+  try {
+    await gateway.capture(order.paymentId);
+  } catch (err) {
+    logger.warn("capture failed", { orderId: order.id, err });
+  }
+  await orders.setStatus(order.id, "paid");
+
+  try {
+    await mailer.sendReceipt(order.id);
+  } catch (err) {
+    logger.warn("receipt email failed", { orderId: order.id, err });
+  }
 }
